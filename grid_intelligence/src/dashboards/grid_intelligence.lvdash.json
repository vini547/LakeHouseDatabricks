            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {"fieldName": "sum(chamados_risco_saude)", "displayName": "Chamados com risco à saúde",
                          "format": {"type": "number", "decimalPlaces": {"type": "max", "places": 0}}},
                "period": {"fieldName": "daily(dia)"}
              },
              "frame": {"showTitle": true, "title": "Chamados com risco à saúde (30 dias)"}
            }
          },
          "position": {"x": 6, "y": 2, "width": 3, "height": 4}
        },
        {
          "widget": {
            "name": "kpi-prioridade-alta",
            "queries": [{
              "name": "main_query",
              "query": {
                "datasetName": "ds_kpis_diario",
