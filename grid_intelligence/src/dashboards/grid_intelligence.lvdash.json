                "datasetName": "ds_kpis_diario",
                "fields": [
                  {"name": "sum(chamados_risco_saude)", "expression": "SUM(`chamados_risco_saude`)"},
                  {"name": "daily(dia)", "expression": "DATE_TRUNC(\"DAY\", `dia`)"}
                ],
                "disaggregated": false
              }
