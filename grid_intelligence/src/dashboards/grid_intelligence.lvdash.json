                  {"name": "sum(uc_horas)", "expression": "SUM(`uc_horas`)"}
                ],
                "disaggregated": false
              }
            }],
            "spec": {
              "version": 1,
              "widgetType": "combo",
              "encodings": {
                "x": {"fieldName": "daily(dia)", "scale": {"type": "temporal"}},
                "y": {
                  "scale": {"type": "quantitative"},
                  "primary": {"fields": [{"fieldName": "sum(chamados)", "displayName": "Chamados"}]},
                  "secondary": {"fields": [{"fieldName": "sum(uc_horas)", "displayName": "Horas UC sem fornecimento"}]}
