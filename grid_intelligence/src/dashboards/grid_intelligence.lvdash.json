{
  "datasets": [
    {
      "name": "ds_kpis_diario",
      "displayName": "KPIs diarios (30 dias)",
      "queryLines": [
        "SELECT dia, sum(uc_horas_interrompidas) AS horas_uc, sum(chamados) AS chamados, sum(chamados_risco_saude) AS chamados_risco_saude, sum(uc_prioridade_alta) AS uc_prioridade_alta ",
        "FROM painel_operacional_dia ",
        "WHERE dia >= date_sub((SELECT max(dia) FROM painel_operacional_dia), 29) ",
        "GROUP BY dia ORDER BY dia"
      ]
    },
    {
      "name": "ds_serie",
      "displayName": "Chamados e horas sem fornecimento (historico)",
      "queryLines": [
        "SELECT dia, sum(chamados) AS chamados, sum(uc_horas_interrompidas) AS uc_horas ",
        "FROM painel_operacional_dia ",
        "GROUP BY dia ORDER BY dia"
      ]
    },
    {
      "name": "ds_dec",
      "displayName": "DEC por conjunto (metric view)",
      "queryLines": [
        "SELECT `Conjunto` AS conjunto, MEASURE(`DEC`) AS dec ",
        "FROM continuidade_metricas ",
        "GROUP BY ALL ORDER BY dec DESC"
      ]
    },
    {
      "name": "ds_acoes",
      "displayName": "Acoes ultimos 14 dias",
      "queryLines": [
        "SELECT dia, id_conjunto, nome_conjunto, uc_horas_interrompidas, chamados_risco_saude, uc_prioridade_alta, acao_recomendada ",
        "FROM painel_operacional_dia ",
        "WHERE acao_recomendada IN ('Visita ou contato imediato: ha clientes em risco a saude', 'Acionar ouvidoria e dar retorno ao cliente no mesmo dia', 'Acionar rede: interromper a causa antes do proximo ciclo; verificar conjuntos afetados') ",
        "AND dia >= date_sub((SELECT max(dia) FROM painel_operacional_dia), 13) ",
        "ORDER BY dia DESC, CASE acao_recomendada WHEN 'Visita ou contato imediato: ha clientes em risco a saude' THEN 1 WHEN 'Acionar ouvidoria e dar retorno ao cliente no mesmo dia' THEN 2 ELSE 3 END ",
        "LIMIT 30"
      ]
    },
    {
      "name": "ds_bairros",
      "displayName": "UCs por bairro e prioridade (top 12)",
      "queryLines": [
        "SELECT bairro, prioridade_inspecao, count(*) AS ucs ",
        "FROM prioridade_inspecao_uc ",
        "WHERE bairro IN (SELECT bairro FROM prioridade_inspecao_uc GROUP BY bairro ORDER BY count(*) DESC LIMIT 12) ",
        "GROUP BY bairro, prioridade_inspecao ORDER BY bairro, prioridade_inspecao"
      ]
    },
    {
      "name": "ds_prioridade",
      "displayName": "Detalhe da priorizacao",
      "queryLines": [
        "SELECT id_uc, bairro, classe_consumo, prioridade_inspecao, round(variacao_da_uc, 4) AS variacao_da_uc, round(consumo_medio_baseline_kwh, 1) AS consumo_medio_baseline_kwh, round(consumo_medio_recente_kwh, 1) AS consumo_medio_recente_kwh, motivo_observado ",
        "FROM prioridade_inspecao_uc ",
        "ORDER BY CASE prioridade_inspecao WHEN 'alta' THEN 1 WHEN 'media' THEN 2 ELSE 3 END, variacao_da_uc LIMIT 50"
      ]
    },
    {
      "name": "ds_ouvidoria",
      "displayName": "Clientes em risco de ouvidoria",
      "queryLines": [
        "SELECT id_cliente, qtd_chamados, qtd_ucs_com_chamado, qtd_mencoes_ouvidoria, round(proporcao_negativa, 2) AS proporcao_negativa, reincidente, motivo_predominante, ultima_fala ",
        "FROM saude_cliente ",
        "WHERE risco_ouvidoria = 'alto' ORDER BY qtd_mencoes_ouvidoria DESC, qtd_chamados DESC LIMIT 50"
      ]
    }
  ],
  "pages": [
    {
      "name": "operacao",
      "displayName": "Operacao do dia",
      "pageType": "PAGE_TYPE_CANVAS",
      "layoutVersion": "GRID_V1",
      "layout": [
        {
          "widget": {
            "name": "title",
            "multilineTextboxSpec": {
              "lines": ["## Grid Intelligence — Operação do dia\n"]
            }
          },
          "position": {"x": 0, "y": 0, "width": 12, "height": 1}
        },
        {
          "widget": {
            "name": "subtitle",
            "multilineTextboxSpec": {
              "lines": ["O que aconteceu e o que precisa de acao hoje — para o gestor de operacoes, as 8h da manha."]
            }
          },
          "position": {"x": 0, "y": 1, "width": 12, "height": 1}
        },
        {
          "widget": {
            "name": "kpi-horas-uc",
            "queries": [{
              "name": "main_query",
              "query": {
                "datasetName": "ds_kpis_diario",
                "fields": [
                  {"name": "sum(horas_uc)", "expression": "SUM(`horas_uc`)"},
                  {"name": "daily(dia)", "expression": "DATE_TRUNC(\"DAY\", `dia`)"}
                ],
                "disaggregated": false
              }
            }],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {"fieldName": "sum(horas_uc)", "displayName": "Horas UC sem fornecimento",
                          "format": {"type": "number", "abbreviation": "compact", "decimalPlaces": {"type": "max", "places": 1}}},
                "period": {"fieldName": "daily(dia)"}
              },
              "frame": {"showTitle": true, "title": "Horas UC sem fornecimento (30 dias)"}
            }
          },
          "position": {"x": 0, "y": 2, "width": 3, "height": 4}
        },
        {
          "widget": {
            "name": "kpi-chamados",
            "queries": [{
              "name": "main_query",
              "query": {
                "datasetName": "ds_kpis_diario",
                "fields": [
                  {"name": "sum(chamados)", "expression": "SUM(`chamados`)"},
                  {"name": "daily(dia)", "expression": "DATE_TRUNC(\"DAY\", `dia`)"}
                ],
                "disaggregated": false
              }
            }],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {"fieldName": "sum(chamados)", "displayName": "Chamados",
                          "format": {"type": "number", "abbreviation": "compact", "decimalPlaces": {"type": "max", "places": 0}}},
